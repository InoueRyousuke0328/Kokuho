<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" id="WebApp_ID" version="6.0">
  <display-name>kokuho</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
  </welcome-file-list>
  
<!-- ゲストトップページで検索エラーになったとき-->

<!-- サーバー処理中のエラー-->
  <error-page>
    <error-code>500</error-code>
    <location>/error/error.jsp</location>
  </error-page>
  
<!-- ページがない -->
<error-page>
    <error-code>404</error-code>
    <location>/error/notFound.jsp</location>
</error-page>
<!-- filterはリクエストにしかかからない。returnに注意 -->
<filter>
   <filter-name>EncodingFilter</filter-name>
   <filter-class>tool.EncodingFilter</filter-class>
 </filter>
  <filter-mapping>
     <filter-name>EncodingFilter</filter-name>
     <url-pattern>/*</url-pattern>
</filter-mapping>

<filter>
   <filter-name>AdminLoginFilter</filter-name>
   <filter-class>tool.AdminLoginFilter</filter-class>
</filter>
<filter-mapping>
     <filter-name>AdminLoginFilter</filter-name>
     <url-pattern>/admin/*</url-pattern>
</filter-mapping>

<filter>
       <filter-name>AdminSessionOutFilter</filter-name>
       <filter-class>tool.AdminSessionOutFilter</filter-class>
</filter>
<filter-mapping>
       <filter-name>AdminSessionOutFilter</filter-name>
       <url-pattern>/admin/admin-index.jsp</url-pattern>
</filter-mapping>
<filter>
   <filter-name>UserLoginFilter</filter-name>
   <filter-class>tool.UserLoginFilter</filter-class>
</filter>
<filter-mapping>
     <filter-name>UserLoginFilter</filter-name>
     <url-pattern>/user/*</url-pattern>
</filter-mapping>
<filter-mapping>
     <filter-name>UserLoginFilter</filter-name>
     <url-pattern>/review/*</url-pattern>
</filter-mapping>

<filter>
       <filter-name>UserSessionOutFilter</filter-name>
       <filter-class>tool.UserSessionOutFilter</filter-class>
</filter>
<filter-mapping>
       <filter-name>UserSessionOutFilter</filter-name>
       <url-pattern>/user/index.jsp</url-pattern>
</filter-mapping>

 
</web-app>